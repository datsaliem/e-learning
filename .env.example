# Copy this file to .env.local and fill in real values.
# Every NEXT_PUBLIC_* value is bundled into browser code. Never put a secret
# key, service role, Stripe secret, webhook secret, or Resend key in it.

# Canonical app URL used by Auth callbacks, Stripe Checkout, email links and SEO.
# Production must use HTTPS and a stable domain, not a commit deployment URL.
NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# Supabase browser credentials. Prefer the modern sb_publishable_* key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-browser-key

# Vercel server-only credentials.
# Prefer sb_secret_*. The legacy service role is supported only as a fallback.
SUPABASE_SECRET_KEY=sb_secret_your-server-only-key
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key

PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-endpoint-signing-secret

# Optional in Preview only. Production stack traces stay disabled by default.
# ENABLE_STACK_TRACES=true

# Supabase Edge Function secrets (set with `supabase secrets set`, not Vercel).
# Verify the sender domain in Resend before launch.
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=E-Learning <hello@your-verified-domain.com>
# RESEND_REPLY_TO=support@your-verified-domain.com
EMAIL_APP_URL=https://your-production-domain.com
# EMAIL_WORKER_BATCH_SIZE=10
