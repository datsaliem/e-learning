# Copy this file to .env.local and fill in real values.
# Biến bắt đầu bằng NEXT_PUBLIC_ được expose ra trình duyệt (client-side).

# URL public của app (dùng cho metadata, canonical link, callback...)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL của API backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Supabase — lấy trong Project Settings > API. Chỉ dùng anon/publishable key
# ở đây, KHÔNG BAO GIỜ đặt service_role key vào biến NEXT_PUBLIC_* vì nó sẽ
# lộ ra trình duyệt và bỏ qua toàn bộ Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Payment backend — tuyệt đối không thêm NEXT_PUBLIC_ vào các biến bên dưới.
# Ưu tiên Supabase secret key (sb_secret_...). Chỉ dùng service_role legacy
# khi project chưa chuyển sang hệ key mới.
SUPABASE_SECRET_KEY=sb_secret_your-server-only-key
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key

PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-endpoint-signing-secret
